# Copy this file to .env for local development and fill in real values.
# In production (Vercel), set these under Project Settings -> Environment Variables.

# Neon Postgres connection string (Neon dashboard -> your project -> Connection string)
DATABASE_URL=

# Shared password for the catalogue admin page (/admin/login)
ADMIN_PASSWORD=

# Random string, 32+ characters, used to encrypt the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
